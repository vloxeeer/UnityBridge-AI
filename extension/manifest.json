{
  "manifest_version": 3,
  "name": "UnityBridge AI — подключение к Unity",
  "version": "0.1.0",
  "description": "Добавляет кнопку «⚡ Подключить к Unity» рядом с текстовыми полями на AI-сайтах (arena.ai и др.) и отправляет запрос в Unity через локальный мост.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:17777/*",
    "http://localhost:17777/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UnityBridge AI"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
